{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WordFlow",
  "version": "2.0.0",
  "identifier": "com.2048labs.speaktype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "WordFlow",
        "url": "index.html",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      },
      {
        "label": "pill",
        "title": "WordFlow Recorder",
        "url": "pill.html",
        "width": 520,
        "height": 84,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "tray",
        "title": "WordFlow",
        "url": "tray.html",
        "width": 356,
        "height": 520,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Offline voice dictation",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4RTlBMzJFQkJGMjE0QzAKUldUQUZQSzdMcVBweU92Q2ZKRFpSTVJJQlVWSmlJZ3lnN3dpZW5EZ1dUNi95dlJ6S2M5SlBzcXYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
