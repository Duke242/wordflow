{
  "name": "wordflow",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "app": "tauri dev",
    "app:build": "node scripts/build-cleanup-worker.mjs && tauri build --config src-tauri/tauri.cleanup.conf.json",
    "worker:build": "node scripts/build-cleanup-worker.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
